{
    "compilerOptions": {
        "declaration": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["ESNext", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["bun"]
    },
    "exclude": ["dist/", "node_modules", "**/node_modules/*"]
}
